---
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
---

<RosterEaseLayout
  title="Credits"
  description="Credits and licence information for the RosterEase website’s 3D artwork."
>
  <div class="re-shell">
    <section class="re-page-intro">
      <p class="re-kicker">Credits</p><h1>The details behind the design.</h1>
    </section>
    <article class="re-prose">
      <section>
        <h2>iPhone 3D model</h2>
        <p>
          <a
            href="https://sketchfab.com/3d-models/iphone-17-pro-max-87fc1df741384124a8ce0226d2b2058d"
            >iPhone 17 Pro Max</a
          > by <a href="https://sketchfab.com/MG990">MajdyModels</a>, licensed
          under <a href="https://creativecommons.org/licenses/by/4.0/"
            >Creative Commons Attribution 4.0</a
          >.
        </p>
        <p>
          We optimised the model, adjusted its materials and scale, and replaced
          the display with RosterEase screenshots. The model was obtained
          through <a href="https://github.com/quentin-pla/phone-mockup-studio"
            >Phone Mockup Studio</a
          >.
        </p>
        <p>
          This is an independently created visualisation, not an official Apple
          asset. iPhone is a trademark of Apple Inc. This website is not
          affiliated with or endorsed by Apple.
        </p>
      </section>
    </article>
  </div>
</RosterEaseLayout>
