---
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
import DeviceFrame from "../components/DeviceFrame.astro";
import { screens } from "../lib/screenshots";
import { devices, type DeviceName } from "../lib/devices";
import AppStoreBadge from "../components/AppStoreBadge.astro";
---

<RosterEaseLayout
  title="The app"
  storeBadgeInFooter={false}
  description="Explore repeating shift patterns, client visits, on-device Smart Import and the privacy choices that make RosterEase a personal workday planner."
>
  <div class="re-shell">
    <section class="re-page-intro">
      <p class="re-kicker">A closer look</p><h1>
        Your shifts.<br />Your client visits.
      </h1><p>
        Shifts is for a roster that repeats. Visits is for a day of client
        visits. Both show your week and what's next.
      </p><nav class="re-subnav" aria-label="On this page">
        <a href="#shift">Shifts</a><a href="#field">Visits</a><a
          href="#everyday">Everyday details</a
        ><a href="#privacy">Privacy</a><a href="#plus">Free & Plus</a>
      </nav>
    </section>
    <section class="re-feature" id="shift">
      <div>
        <p class="re-kicker">Shifts</p><h2>
          Set your roster once.<br />Change a day in a tap.
        </h2><p>
          Add your workplace and your shift pattern, and RosterEase fills in
          the weeks ahead. Swapped a shift? Change that one day.
        </p><ul>
          <li>Day, night and overnight shifts in a repeating rotation.</li><li>
            One-off, split and double shifts on any date.
          </li><li>
            When to leave, start and finish, with notes and check-ins, in Today.
          </li><li>Optional Apple Calendar sync to a calendar you choose.</li>
        </ul><a class="re-text-link" href="/help/getting-started/"
          >Set up your first workplace →</a
        >
      </div><div class="re-feature-visual">
        <DeviceFrame
          device="iphone17"
          screen={screens.shiftCalendar}
          sizes="(max-width: 720px) 80vw, 320px"
          eager
        />
      </div>
    </section>
    <section class="re-feature re-feature--stacked" id="field">
      <div>
        <p class="re-kicker">Visits</p><h2>
          Every visit,<br />in the order you go.
        </h2><p>
          Keep your clients, addresses and visit times in one place. Work
          through your list and tick each visit off as you go.
        </p><ul>
          <li>A client directory with visit details and private notes.</li><li>
            Saved locations shared by several clients.
          </li><li>
            Notes with checklists, photos, voice notes and signatures.
          </li><li>
            Travel buffers between visits, with optional Maps estimates.
          </li><li>
            Today's next stop, directions and completion progress.
          </li><li>A calendar for looking ahead at your route days.</li>
        </ul><p class="re-note">
          You control the visit order. RosterEase does not automatically
          optimise routes or replace a clinical record or employer scheduling
          system.
        </p><a class="re-text-link" href="/help/getting-started/#field"
          >Set up your visits →</a
        >
      </div><div class="re-device-row">
        {
          [
            { device: "ipad" as DeviceName, screen: screens.ipadFieldToday, label: "Today on iPad" },
            { device: "ipad" as DeviceName, screen: screens.ipadFieldCalendar, label: "Calendar on iPad" },
          ].map(({ device, screen, label }) => (
            <a
              href={screen.light.src}
              data-screenshot
              aria-label={`Enlarge ${label} screenshot`}
              style={`--device-aspect: ${devices[device].frame.width / devices[device].frame.height}`}
            >
              <DeviceFrame
                device={device}
                screen={screen}
                sizes="(max-width: 720px) 45vw, 520px"
              />
            </a>
          ))
        }
      </div>
    </section>
    <section class="re-feature re-feature--stacked" id="duo">
      <div>
        <p class="re-kicker">iPhone Duo</p><h2>
          Folded or open.
        </h2><p>
          Today fits the outer display when it's folded. Open it and your coming
          shifts sit beside the next one.
        </p>
      </div><div class="re-device-row">
        {
          [
            { device: "duoOuter" as DeviceName, screen: screens.duoOuterShiftToday, label: "Folded" },
            { device: "duoInner" as DeviceName, screen: screens.duoInnerShiftToday, label: "Open" },
          ].map(({ device, screen, label }) => (
            <a
              href={screen.light.src}
              data-screenshot
              aria-label={`Enlarge ${label} iPhone Duo screenshot`}
              style={`--device-aspect: ${devices[device].frame.width / devices[device].frame.height}`}
            >
              <DeviceFrame
                device={device}
                screen={screen}
                sizes="(max-width: 720px) 60vw, 760px"
              />
            </a>
          ))
        }
      </div>
    </section>
    <section class="re-feature-pair" id="everyday">
      <div>
        <p class="re-kicker">Less retyping</p><h2>
          Import a roster<br />or client list.
        </h2><p>
          Take a photo, open a PDF or paste the text. RosterEase reads it on
          your phone and shows you the shifts or clients. Check them, fix
          anything wrong, then add them.
        </p><p>
          A dated roster imports as dated shifts, including split or double
          shifts, or as a repeating rotation. One import covers one workplace.
        </p><a class="re-text-link" href="/help/smart-import/"
          >Understand Smart Import →</a
        >
      </div><div>
        <p class="re-kicker">Around your day</p><h2>
          Check your next shift or visit.
        </h2><p>
          Check Today on your phone, see more on iPad, or glance at a
          widget, the Lock Screen or the Live Activity. With Plus, ask Siri for
          your next shift or today's visits.
        </p><p>
          Leave times are a guide. If timing is tight, check your roster and
          the traffic.
        </p><a class="re-text-link" href="/help/calendar-and-privacy/"
          >Calendar, Maps and privacy choices →</a
        >
      </div>
    </section>
    <section class="re-feature-pair" id="privacy">
      <div>
        <p class="re-kicker">On-device processing</p><h2>
          Import without<br />a cloud AI service.
        </h2><p>
          No RosterEase account is required. Import extraction and parsing run
          on your device, without uploading roster or client contents to a cloud
          AI service. The app does not use advertising or analytics.
        </p><p>
          Calendar sync is optional. Private shift notes are
          excluded from Calendar events unless you enable them. Maps receives
          address or location text, not client names or private notes.
        </p><a class="re-text-link" href="/on-device/"
          >See what stays local and what is shared →</a
        >
      </div><div>
        <p class="re-kicker">Keep a copy</p><h2>A backup you control.</h2><p>
          Save an encrypted backup when you choose, or weekly to a folder you
          pick. One backup key, kept in your Keychain, opens them all.
        </p><p>
          There is no automatic RosterEase cloud sync. A storage provider you
          select, such as iCloud Drive, handles your exported file under its own
          terms.
        </p><a class="re-text-link" href="/help/backup-and-restore/"
          >Back up and restore safely →</a
        >
      </div>
    </section>
    <section class="re-feature-pair" id="plus">
      <div>
        <p class="re-kicker">Free & RosterEase Plus</p><h2>
          Free to start.<br />Plus when you need more.
        </h2><p>
          Free includes one workplace in Shifts or five active clients in
          Visits, with Calendar, widgets, Live Activities and backups. Finishing
          setup starts a free week of full Plus that doesn't renew.
        </p><p>
          Shift Plus adds more workplaces, worked times suggested from location,
          pinned workplace notes and Siri answers. Visits Plus adds more clients
          and includes Shift Plus. Each is monthly or annual; the App Store
          shows your local price.
        </p><a class="re-text-link" href="/terms/"
          >Subscriptions and Terms of Use →</a
        >
      </div><div id="beta">
        <p class="re-kicker">Available now</p><h2>
          Make your next<br />workday easier.
        </h2><p>
          Download RosterEase from the App Store for iPhone and iPad.
          These screenshots use fictional data; appearance can vary by
          device and app version.
        </p><AppStoreBadge /><p>
          Want to help test upcoming features? <a href="/beta/">Explore beta access</a>.
        </p>
      </div>
    </section>
  </div>
</RosterEaseLayout>
