---
import RosterEaseLayout from "../../layouts/RosterEaseLayout.astro";
import { getImage } from "astro:assets";
import PhoneScreenshot from "../../components/PhoneScreenshot.astro";
import { guides, type Guide } from "../../lib/guides";
import { helpRecordings, helpScreens } from "../../lib/screenshots";
export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const posters = Object.fromEntries(
  await Promise.all(
    guide.sections
      .flatMap((section) => (section.recording ? [section.recording] : []))
      .map(async (name) => [
        name,
        await getImage({
          src: helpRecordings[name].poster,
          width: 720,
          format: "webp",
          quality: 85,
        }),
      ]),
  ),
);
---

<RosterEaseLayout title={guide.title} description={guide.description}>
  <div class="re-shell">
    <section class="re-page-intro">
      <a class="re-breadcrumb" href="/help/">← All help guides</a><h1>
        {guide.title}
      </h1><p>{guide.description}</p><nav
        class="re-subnav"
        aria-label="Guide contents"
      >
        {
          guide.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))
        }
      </nav>
    </section><article class="re-prose">
      {
        guide.sections.map((section) => (
          <section id={section.id}>
            <h2>{section.title}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.steps && (
              <ol>
                {section.steps.map((step) => (
                  <li>{step}</li>
                ))}
              </ol>
            )}
            {section.screens && (
              <div class="re-help-screens">
                {section.screens.map((name) => (
                  <PhoneScreenshot screen={helpScreens[name]} />
                ))}
              </div>
            )}
            {section.recording && (
              <figure class="re-help-recording">
                <video
                  controls
                  muted
                  playsinline
                  preload="none"
                  poster={posters[section.recording].src}
                  width="720"
                  height={Math.round(
                    (720 * helpRecordings[section.recording].poster.height) /
                      helpRecordings[section.recording].poster.width,
                  )}
                  aria-label={helpRecordings[section.recording].label}
                >
                  <source
                    src={`/media/help/${section.recording}.webm`}
                    type="video/webm"
                  />
                  <source
                    src={`/media/help/${section.recording}.mp4`}
                    type="video/mp4"
                  />
                </video>
                <figcaption>{helpRecordings[section.recording].label}</figcaption>
              </figure>
            )}
          </section>
        ))
      }<section>
        <h2>Need more help?</h2><p>
          <a href="/contact/">Contact support</a> with your build number and the step
          you reached. Please redact personal or workplace-confidential details from
          any examples.
        </p><p><a href="/privacy/">Read the Privacy Policy</a></p>
      </section>
    </article>
  </div>
</RosterEaseLayout>
