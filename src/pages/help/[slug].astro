---
import RosterEaseLayout from "../../layouts/RosterEaseLayout.astro";
import DeviceFrame from "../../components/DeviceFrame.astro";
import HelpText from "../../components/HelpText.astro";
import NarratedGuide from "../../components/NarratedGuide.astro";
import catalogue from "../../assets/rosterease/support-guides/catalogue.json";
import { guides, type Guide } from "../../lib/guides";
import { helpScreens } from "../../lib/screenshots";
export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const recordings = catalogue.filter((recording) => recording.article === guide.slug);
---

<RosterEaseLayout title={guide.title} description={guide.description}>
  <div class="re-shell">
    <section class="re-page-intro">
      <a class="re-breadcrumb" href="/help/">← All help guides</a><h1>
        {guide.title}
      </h1><p>{guide.description}</p><p>
        These guides cover RosterEase 1.1. Check your version in Settings &gt; About;
        older versions have different controls and features.
      </p><nav
        class="re-subnav"
        aria-label="Guide contents"
      >
        <a href="#watch">Watch</a>
        {
          guide.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))
        }
      </nav>
    </section><article class="re-prose re-help-article">
      <section id="watch" aria-labelledby="watch-heading">
        <h2 id="watch-heading">Watch the walkthrough{recordings.length > 1 ? "s" : ""}</h2>
        <p>Narration uses AI-generated voices. You can also follow the written steps below.</p>
        <div class="re-support-guides">
          {recordings.map((recording) => <NarratedGuide guide={recording} />)}
        </div>
      </section>
      {
        guide.sections.map((section) => {
          const hasMedia = Boolean(section.screens);
          return (
            <section
              id={section.id}
              class:list={{ "re-help-section--media": hasMedia }}
            >
              <div>
                <h2>{section.title}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p><HelpText text={paragraph} /></p>
                ))}
                {section.steps && (
                  <ol class="re-help-steps">
                    {section.steps.map((step) => (
                      <li><HelpText text={step} /></li>
                    ))}
                  </ol>
                )}
                {section.after?.map((paragraph) => (
                  <p><HelpText text={paragraph} /></p>
                ))}
              </div>
              {hasMedia && (
                <div class="re-help-media">
                  {section.screens?.map((name) => (
                    <DeviceFrame
                      device="iphone17"
                      screen={helpScreens[name]}
                      sizes="(max-width: 720px) 45vw, 280px"
                    />
                  ))}
                </div>
              )}
            </section>
          );
        })
      }<section>
        <h2>Need more help?</h2><p>
          <a href="/contact/">Contact support</a> with your build number and the step
          you reached. Please redact personal or workplace-confidential details from
          any examples.
        </p><p><a href="/privacy/">Read the Privacy Policy</a></p>
      </section>
    </article>
  </div>
</RosterEaseLayout>
