---
import RosterEaseLayout from "../../layouts/RosterEaseLayout.astro";
import { getImage } from "astro:assets";
import DeviceFrame from "../../components/DeviceFrame.astro";
import HelpText from "../../components/HelpText.astro";
import { guides, type Guide } from "../../lib/guides";
import { helpRecordings, helpScreens } from "../../lib/screenshots";
export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const posters = Object.fromEntries(
  await Promise.all(
    guide.sections
      .flatMap((section) => (section.recording ? [section.recording] : []))
      .map(async (name) => [
        name,
        await getImage({
          src: helpRecordings[name].start,
          width: 720,
          format: "webp",
          quality: 85,
        }),
      ]),
  ),
);
---

<RosterEaseLayout title={guide.title} description={guide.description}>
  <div class="re-shell">
    <section class="re-page-intro">
      <a class="re-breadcrumb" href="/help/">← All help guides</a><h1>
        {guide.title}
      </h1><p>{guide.description}</p><nav
        class="re-subnav"
        aria-label="Guide contents"
      >
        {
          guide.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))
        }
      </nav>
    </section><article class="re-prose re-help-article">
      {
        guide.sections.map((section) => {
          const hasMedia = Boolean(section.screens || section.recording);
          return (
            <section
              id={section.id}
              class:list={{ "re-help-section--media": hasMedia }}
            >
              <div>
                <h2>{section.title}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p><HelpText text={paragraph} /></p>
                ))}
                {section.steps && (
                  <ol class="re-help-steps">
                    {section.steps.map((step) => (
                      <li><HelpText text={step} /></li>
                    ))}
                  </ol>
                )}
                {section.after?.map((paragraph) => (
                  <p><HelpText text={paragraph} /></p>
                ))}
              </div>
              {hasMedia && (
                <div class="re-help-media">
                  {section.recording && (
                    <DeviceFrame
                      device="iphone17"
                      sizes="(max-width: 720px) 80vw, 280px"
                    >
                      <video
                        autoplay
                        muted
                        loop
                        playsinline
                        disablepictureinpicture
                        disableremoteplayback
                        poster={posters[section.recording].src}
                        aria-label={helpRecordings[section.recording].label}
                        data-help-recording
                      >
                        <source
                          media="(max-width: 720px)"
                          src={`/media/help/${section.recording}-mobile.webm`}
                          type="video/webm"
                        />
                        <source
                          media="(max-width: 720px)"
                          src={`/media/help/${section.recording}-mobile.mp4`}
                          type="video/mp4"
                        />
                        <source
                          src={`/media/help/${section.recording}.webm`}
                          type="video/webm"
                        />
                        <source
                          src={`/media/help/${section.recording}.mp4`}
                          type="video/mp4"
                        />
                      </video>
                      <button
                        class="re-recording-toggle"
                        type="button"
                        aria-label="Pause recording"
                      />
                    </DeviceFrame>
                  )}
                  {section.screens?.map((name) => (
                    <DeviceFrame
                      device="iphone17"
                      screen={helpScreens[name]}
                      sizes="(max-width: 720px) 45vw, 280px"
                    />
                  ))}
                </div>
              )}
            </section>
          );
        })
      }<section>
        <h2>Need more help?</h2><p>
          <a href="/contact/">Contact support</a> with your build number and the step
          you reached. Please redact personal or workplace-confidential details from
          any examples.
        </p><p><a href="/privacy/">Read the Privacy Policy</a></p>
      </section>
    </article>
  </div>
</RosterEaseLayout>
<script>
  // Recordings loop silently while on screen. Tapping one pauses or resumes it;
  // with Reduce Motion on they wait on their first frame until tapped.
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
  document
    .querySelectorAll<HTMLVideoElement>("video[data-help-recording]")
    .forEach((video) => {
      const toggle = video.parentElement?.querySelector<HTMLButtonElement>(
        ".re-recording-toggle",
      );
      let held = reduceMotion;
      if (held) video.pause();
      const label = () =>
        toggle?.setAttribute(
          "aria-label",
          video.paused ? "Play recording" : "Pause recording",
        );
      video.addEventListener("play", label);
      video.addEventListener("pause", label);
      label();
      toggle?.addEventListener("click", () => {
        held = !video.paused;
        if (held) video.pause();
        else void video.play().catch(() => {});
      });
      new IntersectionObserver(([entry]) => {
        if (!entry.isIntersecting) video.pause();
        else if (!held) void video.play().catch(() => {});
      }).observe(video);
    });
</script>
