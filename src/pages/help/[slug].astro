---
import RosterEaseLayout from "../../layouts/RosterEaseLayout.astro";
import { getImage } from "astro:assets";
import DeviceFrame from "../../components/DeviceFrame.astro";
import { guides, type Guide } from "../../lib/guides";
import { helpRecordings, helpScreens } from "../../lib/screenshots";
export function getStaticPaths() {
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}
interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const posters = Object.fromEntries(
  await Promise.all(
    guide.sections
      .flatMap((section) => (section.recording ? [section.recording] : []))
      .map(async (name) => [
        name,
        await getImage({
          src: helpRecordings[name].poster,
          width: 720,
          format: "webp",
          quality: 85,
        }),
      ]),
  ),
);
---

<RosterEaseLayout title={guide.title} description={guide.description}>
  <div class="re-shell">
    <section class="re-page-intro">
      <a class="re-breadcrumb" href="/help/">← All help guides</a><h1>
        {guide.title}
      </h1><p>{guide.description}</p><nav
        class="re-subnav"
        aria-label="Guide contents"
      >
        {
          guide.sections.map((section) => (
            <a href={`#${section.id}`}>{section.title}</a>
          ))
        }
      </nav>
    </section><article class="re-prose re-help-article">
      {
        guide.sections.map((section) => {
          const hasMedia = Boolean(section.screens || section.recording);
          return (
            <section
              id={section.id}
              class:list={{ "re-help-section--media": hasMedia }}
            >
              <div>
                <h2>{section.title}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.steps && (
                  <ol>
                    {section.steps.map((step) => (
                      <li>{step}</li>
                    ))}
                  </ol>
                )}
              </div>
              {hasMedia && (
                <div class="re-help-media">
                  {section.recording && (
                    <DeviceFrame device="iphone17" sizes="(max-width: 720px) 80vw, 280px">
                      <video
                        controls
                        muted
                        playsinline
                        preload="none"
                        poster={posters[section.recording].src}
                        aria-label={helpRecordings[section.recording].label}
                      >
                        <source
                          src={`/media/help/${section.recording}.webm`}
                          type="video/webm"
                        />
                        <source
                          src={`/media/help/${section.recording}.mp4`}
                          type="video/mp4"
                        />
                      </video>
                    </DeviceFrame>
                  )}
                  {section.screens?.map((name) => (
                    <DeviceFrame
                      device="iphone17"
                      screen={helpScreens[name]}
                      sizes="(max-width: 720px) 45vw, 280px"
                    />
                  ))}
                </div>
              )}
            </section>
          );
        })
      }<section>
        <h2>Need more help?</h2><p>
          <a href="/contact/">Contact support</a> with your build number and the step
          you reached. Please redact personal or workplace-confidential details from
          any examples.
        </p><p><a href="/privacy/">Read the Privacy Policy</a></p>
      </section>
    </article>
  </div>
</RosterEaseLayout>
