---
import RosterEaseLayout from "../../layouts/RosterEaseLayout.astro";
import { guides } from "../../lib/guides";
---

<RosterEaseLayout
  title="Help guides"
  description="Practical RosterEase guides for setup, plans, imports, shifts and visits, records, privacy and backups."
>
  <div class="re-shell">
    <section class="re-page-intro">
      <p class="re-kicker">Help guides</p><h1>
        Set up and use<br />RosterEase.
      </h1><p>
        These guides cover RosterEase 1.1. Check your version in Settings &gt; About;
        older versions have different controls and features.
      </p>
    </section><div class="re-guide-list">
      {
        guides.map((guide) => (
          <a class="re-guide-link" href={`/help/${guide.slug}/`}>
            <>
              <h2>{guide.title}</h2>
              <p>{guide.description}</p>
              <span>Read the guide →</span>
            </>
          </a>
        ))
      }
    </div><section class="re-closing">
      <div>
        <h2>Still need a hand?</h2><p>
          Tell us what you were trying to do and where it stopped working.
        </p><a class="re-text-link" href="/contact/">Contact support →</a>
      </div>
    </section>
  </div>
</RosterEaseLayout>
