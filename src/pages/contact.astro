---
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
import { SUPPORT_EMAIL } from "../lib/rosterease";
const actions = [
  {
    title: "Setup and settings",
    text: "Tell us what you were trying to do and where you got stuck. We can help with setup, imports, Calendar, routes and backups.",
    subject: "RosterEase Support",
    label: "Ask for help",
  },
  {
    title: "Report a problem",
    text: "Include the step that failed, what you expected and what happened instead. For a crash or import problem, the build number helps.",
    subject: "RosterEase Bug Report",
    label: "Report a problem",
  },
  {
    title: "Suggest a change",
    text: "Tell us about your workflow or an accessibility improvement that would make RosterEase more useful to you.",
    subject: "RosterEase Feedback",
    label: "Share feedback",
  },
];
---

<RosterEaseLayout
  title="Support"
  description="Contact RosterEase support for setup, Smart Import, Calendar, privacy, backup and restore questions."
>
  <section class="re-subpage-hero">
    <div class="re-shell re-subpage-hero__grid">
      <div>
        <p class="re-kicker">Support</p><h1 class="re-page-title">
          Get help with<br />RosterEase.
        </h1><p class="re-lede">
          Get help with setup, report a problem or suggest a change.
        </p><a class="re-text-link" href="/help">Start with the help guides →</a
        >
      </div><aside class="re-address-panel">
        <span class="re-address-panel__label">Email RosterEase</span><a
          href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a
        ><p>
          The links below open your email app. If that doesn't work, copy this
          address into your usual email service.
        </p><p>
          Please remove personal and workplace-confidential information before
          sending examples.
        </p>
      </aside>
    </div>
  </section>
  <section class="re-shell re-contact-grid">
    {
      actions.map((action) => (
        <article class="re-action-panel">
          <>
            <h2>{action.title}</h2>
            <p>{action.text}</p>
            <a
              class="re-text-link"
              href={`mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent(action.subject)}`}
            >
              {action.label}
            </a>
          </>
        </article>
      ))
    }<article class="re-action-panel">
      <h2>A few useful details.</h2><ul class="re-detail-list">
        <li>Your iPhone or iPad model and OS version.</li><li>
          The RosterEase version and build number.
        </li><li>The steps to reproduce the problem and any error text.</li><li>
          A redacted screenshot, only if it helps. Remove names, addresses,
          phone numbers, identifiers, medical information and private notes.
        </li>
      </ul>
    </article>
  </section>
</RosterEaseLayout>
