---
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
import { SUPPORT_EMAIL, TESTFLIGHT_MAILTO } from "../lib/rosterease";

const supportEmail = SUPPORT_EMAIL;
const supportMailto = `mailto:${supportEmail}?subject=${encodeURIComponent("RosterEase Support")}`;
const bugMailto = `mailto:${supportEmail}?subject=${encodeURIComponent("RosterEase Bug Report")}`;
const feedbackMailto = `${TESTFLIGHT_MAILTO}?subject=${encodeURIComponent("RosterEase Feedback")}`;

const actions = [
  {
    panelClass: "re-action-panel re-action-panel--support",
    label: "General support",
    title: "Need help setting up or reading the roster?",
    text: "Use this for importing a roster, building the pattern, managing workplaces, calendar sync questions, or anything else that feels unclear.",
    href: supportMailto,
    buttonLabel: "Email support",
    buttonClass: "re-button re-button--primary",
  },
  {
    panelClass: "re-action-panel re-action-panel--bug",
    label: "Bug report",
    title: "Something not behaving the way it should?",
    text: "If the app crashes, imports the wrong shift, or does something unexpected, send a report with enough detail for it to be reproduced.",
    href: bugMailto,
    buttonLabel: "Report a bug",
    buttonClass: "re-button re-button--secondary",
  },
  {
    panelClass: "re-action-panel re-action-panel--feedback",
    label: "Feedback",
    title: "Have an idea that would make the app easier to use?",
    text: "Send product feedback, workflow suggestions, or examples of shift problems you want RosterEase to handle better.",
    href: feedbackMailto,
    buttonLabel: "Send feedback",
    buttonClass: "re-button re-button--secondary",
  },
];

const whatHelps = [
  "A short description of what happened.",
  "The iPhone model and iOS version you are using.",
  "A screenshot, sample roster, or the step that triggered the issue if you can share it.",
];
---

<RosterEaseLayout
  title="Contact"
  description="Contact RosterEase support by email."
>
  <section class="re-subpage-hero">
    <div class="re-shell re-subpage-hero__grid">
      <div class="re-subpage-hero__copy">
        <p class="re-kicker">Contact</p>
        <h1 class="re-page-title">Support is handled by email.</h1>
        <p class="re-lede re-subpage-hero__lede">
          Use the shortcut that matches what you need. Each link opens your mail client with the
          subject already filled in.
        </p>
      </div>

      <aside class="re-address-panel">
        <span class="re-address-panel__label">Support email</span>
        <a class="re-address-panel__link" href={supportMailto}>{supportEmail}</a>
        <p>
          For setup help, importing a roster, sync questions, bug reports, or product feedback.
        </p>
      </aside>
    </div>
  </section>

  <section class="re-contact-section">
    <div class="re-shell re-contact-grid">
      {
        actions.map((action) => (
          <article class={action.panelClass}>
            <span class="re-action-panel__label">{action.label}</span>
            <h2>{action.title}</h2>
            <p>{action.text}</p>
            <a class={action.buttonClass} href={action.href}>{action.buttonLabel}</a>
          </article>
        ))
      }

      <article class="re-action-panel re-action-panel--note">
        <span class="re-action-panel__label">What helps</span>
        <h2>Include enough detail to reproduce the problem.</h2>
        <ul class="re-detail-list re-detail-list--compact">
          {whatHelps.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>
</RosterEaseLayout>
