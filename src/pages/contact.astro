---
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
import { SUPPORT_EMAIL } from "../lib/rosterease";

const fallbackSupportMailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("RosterEase Support")}`;
const fallbackBugMailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("RosterEase Bug Report")}`;
const fallbackFeedbackMailto = `mailto:${SUPPORT_EMAIL}?subject=${encodeURIComponent("RosterEase Feedback")}`;

const actions = [
  {
    panelClass: "re-action-panel re-action-panel--support",
    label: "General support",
    title: "Need help with setup, import, route planning, or calendar sync?",
    text: "Tell us what you were trying to do and where it stopped making sense. This is the best place for setup help, imports, routes, calendar sync, backup, restore, reset, or account-adjacent questions.",
    href: fallbackSupportMailto,
    subject: "RosterEase Support",
    buttonLabel: "Get support",
    buttonClass: "re-button re-button--primary",
  },
  {
    panelClass: "re-action-panel re-action-panel--bug",
    label: "Bug report",
    title: "Something not behaving the way it should?",
    text: "If the app crashes, imports the wrong shift or client, mishandles a route day, syncs unexpectedly, or does something odd, send enough detail for it to be reproduced.",
    href: fallbackBugMailto,
    subject: "RosterEase Bug Report",
    buttonLabel: "Report a bug",
    buttonClass: "re-button re-button--secondary",
  },
  {
    panelClass: "re-action-panel re-action-panel--feedback",
    label: "Feedback",
    title: "Have an idea that would make the app easier to use?",
    text: "Send product feedback, workflow suggestions, accessibility notes, or examples of shift and field-work problems you want RosterEase to handle better. If you include a roster, import source, route, client list, screenshot, or PDF, redact sensitive details first.",
    href: fallbackFeedbackMailto,
    subject: "RosterEase Feedback",
    buttonLabel: "Send feedback",
    buttonClass: "re-button re-button--secondary",
  },
];

const whatHelps = [
  "A short description of what happened.",
  "The iPhone model and iOS version you are using.",
  "A screenshot, redacted sample roster, redacted route/client example, or the step that triggered the issue if you can share it.",
  "Remove names, addresses, phone numbers, employee IDs, client identifiers, private support notes, medical notes, and any workplace-confidential details before attaching anything.",
  "If you are using the TestFlight build, include the build number shown in TestFlight or in the app if you can find it.",
];
---

<RosterEaseLayout
  title="Contact"
  description="Get RosterEase support for setup, import, routes, calendar sync, privacy settings, bug reports, and product feedback."
>
  <section class="re-subpage-hero">
    <div class="re-shell re-subpage-hero__grid">
      <div class="re-subpage-hero__copy">
        <p class="re-kicker">Contact</p>
        <h1 class="re-page-title">We’ll help you get RosterEase working.</h1>
        <p class="re-lede re-subpage-hero__lede">
          Choose the closest option and your mail app will open with a prepared subject line.
          A short support reference is added automatically so follow-up messages are easier to connect.
        </p>
      </div>

      <aside class="re-address-panel">
        <span class="re-address-panel__label">Support starts here</span>
        <a
          class="re-button re-button--primary"
          href={fallbackSupportMailto}
          data-support-mailto
          data-support-subject="RosterEase Support"
        >
          Get support
        </a>
        <p>
          For setup help, imports, routes, sync questions, privacy settings, bug reports, or product feedback.
          Please redact roster, client, patient, employee, workplace, payroll, and health details before sending examples.
        </p>
      </aside>
    </div>
  </section>

  <section class="re-contact-section">
    <div class="re-shell re-contact-grid">
      {
        actions.map((action) => (
          <article class={action.panelClass}>
            <span class="re-action-panel__label">{action.label}</span>
            <h2>{action.title}</h2>
            <p>{action.text}</p>
            <a class={action.buttonClass} href={action.href} data-support-mailto data-support-subject={action.subject}>
              {action.buttonLabel}
            </a>
          </article>
        ))
      }

      <article class="re-action-panel re-action-panel--note">
        <span class="re-action-panel__label">What helps</span>
        <h2>Include enough detail to reproduce the problem.</h2>
        <ul class="re-detail-list re-detail-list--compact">
          {whatHelps.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </div>
  </section>
</RosterEaseLayout>

<script define:vars={{ supportMailbox: SUPPORT_EMAIL }}>
  const supportLinks = Array.from(document.querySelectorAll("[data-support-mailto]"));

  function supportReference() {
    const bytes = new Uint8Array(4);
    if (globalThis.crypto?.getRandomValues) {
      globalThis.crypto.getRandomValues(bytes);
    } else {
      for (let index = 0; index < bytes.length; index += 1) {
        bytes[index] = Math.floor(Math.random() * 256);
      }
    }

    const datePart = new Date().toISOString().slice(0, 10).replaceAll("-", "");
    const alphabet = "23456789ABCDEFGHJKLMNPQRSTUVWXYZ";
    const randomPart = Array.from(bytes, (byte) => alphabet[byte % alphabet.length]).join("");
    return `${datePart}-${randomPart}`;
  }

  function assignSupportSubjects() {
    for (const link of supportLinks) {
      const subject = link.getAttribute("data-support-subject") || "RosterEase Support";
      const subjectWithReference = `${subject} - Request ${supportReference()}`;
      link.href = `mailto:${supportMailbox}?subject=${encodeURIComponent(subjectWithReference)}`;
    }
  }

  assignSupportSubjects();
</script>
