---
import { Image } from "astro:assets";
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
import { SUPPORT_EMAIL, SUPPORT_MAILTO, TESTFLIGHT_EMAIL, TESTFLIGHT_MAILTO, TESTFLIGHT_URL } from "../lib/rosterease";
import shiftTodayShot from "../assets/rosterease/screenshots/showcase-release/shift-today.png";
import shiftCalendarShot from "../assets/rosterease/screenshots/showcase-release/shift-calendar.png";
import shiftWorkplacesShot from "../assets/rosterease/screenshots/showcase-release/shift-workplaces.png";
import shiftSettingsShot from "../assets/rosterease/screenshots/showcase-release/shift-settings.png";
import fieldTodayShot from "../assets/rosterease/screenshots/showcase-release/field-today.png";
import fieldCalendarShot from "../assets/rosterease/screenshots/showcase-release/field-calendar.png";
import fieldClientsShot from "../assets/rosterease/screenshots/showcase-release/field-clients.png";
import fieldSettingsShot from "../assets/rosterease/screenshots/showcase-release/field-settings.png";

const modes = [
  {
    label: "Shift Worker",
    icon: "calendar",
    title: "For nurses, hospitality teams, retail staff, emergency services, and anyone working repeating shifts.",
    points: ["Next shift and upcoming days", "Recurring patterns and one-off changes", "Calendar sync with generic notes by default"],
  },
  {
    label: "Field Worker",
    icon: "route",
    title: "For support workers, home health, trades, inspectors, and mobile teams moving between clients.",
    points: ["Clients, visits, and route progress", "Local travel buffers for leave-by guidance", "Apple Maps estimates off by default"],
  },
];

const capabilities = [
  ["Capture", "Start with the roster, screenshot, PDF, file, or pasted text you already have."],
  ["Shape", "Turn it into shifts, visits, route days, and a week that is easier to scan."],
  ["Choose", "Keep Calendar notes, Maps estimates, widgets, and privacy lock settings deliberate."],
  ["Refine", "Use TestFlight feedback to tighten imports, setup, accessibility, and iPad layouts."],
];

const motionItems = [
  {
    animation: "import",
    title: "Import the messy source",
    text: "Start from a roster screenshot, PDF, file, pasted text, or client list instead of recreating every detail by hand.",
  },
  {
    animation: "route",
    title: "Turn it into today’s plan",
    text: "RosterEase converts the source into shifts, calendar days, clients, visits, leave-by guidance, and route progress.",
  },
  {
    animation: "privacy",
    title: "Decide what leaves the app",
    text: "Local notes stay local by default, while Calendar details and Apple Maps estimates are choices you make in settings.",
  },
];

const privacyPoints = [
  ["Local notes by default", "Private shift, workplace, client, and visit notes are kept on device unless you choose another path."],
  ["Generic Calendar notes", "Calendar entries avoid sensitive notes by default, with more detail only if you choose to include it."],
  ["Maps estimates opt-in", "Address-based Apple Maps travel estimates stay off until you enable them for the workflows that need them."],
  ["Redacted feedback", "Failed-import examples are useful for testing, but names, addresses, IDs, client identifiers, and private notes should be removed first."],
];

const showcaseFlows = [
  {
    id: "shift",
    label: "Shift Worker",
    accent: "shift",
    modeHint: "Roster patterns, workplaces, and calendar control",
    title: "A roster becomes a day you can actually follow.",
    text: "Shift Worker mode keeps repeating rosters, one-off changes, workplaces, calendar sync, and privacy controls in one readable flow.",
    steps: [
      {
        label: "Today",
        title: "Know what is on deck",
        text: "Next shift, leave-by timing, workplace, distance, and the week ahead stay visible without digging through a roster PDF.",
        image: shiftTodayShot,
        alt: "RosterEase Shift Worker Today screen showing the next shift, workplace, leave-by guidance, and upcoming days.",
      },
      {
        label: "Calendar",
        title: "See the roster shape",
        text: "Month and day views make rotations, off days, and manual changes easier to scan before the week gets busy.",
        image: shiftCalendarShot,
        alt: "RosterEase Shift Worker Calendar screen showing a monthly roster overview.",
      },
      {
        label: "Workplaces",
        title: "Keep locations organised",
        text: "Workplaces, shift types, time zones, and route defaults stay attached to the schedule that needs them.",
        image: shiftWorkplacesShot,
        alt: "RosterEase Shift Worker Workplaces screen showing configured workplaces and shift setup.",
      },
      {
        label: "Privacy",
        title: "Sync only what you choose",
        text: "Settings keep travel, Calendar sync, backup, privacy lock, and appearance choices explicit instead of hidden in setup.",
        image: shiftSettingsShot,
        alt: "RosterEase Shift Worker settings screen showing workplace, shift type, privacy, and sync controls.",
      },
    ],
  },
  {
    id: "field",
    label: "Field Worker",
    accent: "field",
    modeHint: "Client visits, route progress, and private defaults",
    title: "A route day becomes ordered, private, and practical.",
    text: "Field Worker mode is built for client visits, route progress, local travel buffers, work days, and address-aware choices that stay deliberate.",
    steps: [
      {
        label: "Today",
        title: "Start from the next visit",
        text: "Today shows route progress, visit order, windows, local travel buffers, and when Maps estimates are still off.",
        image: fieldTodayShot,
        alt: "RosterEase Field Worker Today screen showing route progress, visit order, and local travel buffer guidance.",
      },
      {
        label: "Calendar",
        title: "Plan visits across the month",
        text: "Calendar keeps route days and visit counts visible so the work pattern is readable before opening a specific day.",
        image: fieldCalendarShot,
        alt: "RosterEase Field Worker Calendar screen showing route days and scheduled visits.",
      },
      {
        label: "Clients",
        title: "Keep the stop list close",
        text: "Client cards keep visit length, window, and map handoff available while avoiding account setup or a cloud CRM.",
        image: fieldClientsShot,
        alt: "RosterEase Field Worker Clients screen showing synthetic client stops and visit windows.",
      },
      {
        label: "Defaults",
        title: "Make route privacy explicit",
        text: "Settings expose roster mode, travel defaults, work days, privacy lock, backup, restore, and local-first app details.",
        image: fieldSettingsShot,
        alt: "RosterEase Field Worker settings screen showing travel defaults, clients, work days, privacy, and data management controls.",
      },
    ],
  },
];
---

<RosterEaseLayout
  title="RosterEase"
  description="RosterEase turns messy rosters into a clear daily work plan with import, calendar, widget, route, and privacy tools for iPhone and iPad."
>
  <section class="re-hero re-hero--launch">
    <div class="re-shell re-launch-hero__grid">
      <div class="re-launch-hero__copy">
        <p class="re-kicker">RosterEase TestFlight</p>
        <h1 class="re-hero__title">Turn messy rosters into a clear daily work plan.</h1>
        <p class="re-lede">
          Import a screenshot, PDF, file, or pasted roster; shape it into shifts, visits, and route days;
          then keep Calendar, widgets, and privacy settings under your control.
        </p>
        <div class="re-mode-tabs re-mode-tabs--compact" aria-label="RosterEase modes">
          {modes.map((mode) => (
            <article class="re-mode-tabs__panel re-mode-tabs__panel--compact">
              <div class={`re-mode-icon re-mode-icon--${mode.icon}`} aria-hidden="true">
                {mode.icon === "calendar" ? (
                  <svg viewBox="0 0 32 32" role="img"><rect x="6" y="8" width="20" height="18" rx="5"/><path d="M11 5v6M21 5v6M10 15h12M11 20h4M18 20h3"/></svg>
                ) : (
                  <svg viewBox="0 0 32 32" role="img"><path d="M8 24c5-9 11 1 16-8"/><circle cx="8" cy="24" r="3"/><circle cx="24" cy="16" r="3"/><path d="M14 12h4M16 10v4"/></svg>
                )}
              </div>
              <span>For {mode.label.toLowerCase()}s</span>
              <p>{mode.icon === "calendar" ? "Repeating shifts, changes, and workplace days." : "Visits, clients, route days, and leave-by timing."}</p>
            </article>
          ))}
        </div>
        <div class="re-button-row">
          <a class="re-button re-button--primary" href={TESTFLIGHT_URL} target="_blank" rel="noopener" data-testflight-url>
            Join TestFlight
          </a>
          <a class="re-button re-button--secondary" href="#product">See the product</a>
        </div>
        <p class="re-testflight-note">
          Local-first by design, with sensitive sharing kept deliberate. <a href="/privacy">Read privacy details</a>
          or send redacted TestFlight examples to <a href={TESTFLIGHT_MAILTO}>{TESTFLIGHT_EMAIL}</a>.
        </p>
      </div>

      <div class="re-launch-hero__media" aria-label="RosterEase turns roster inputs into a Today plan">
        <div class="re-hero-source-stack" aria-hidden="true">
          <span class="re-hero-source-card re-hero-source-card--screenshot">Roster screenshot</span>
          <span class="re-hero-source-card re-hero-source-card--pdf">PDF</span>
          <span class="re-hero-source-card re-hero-source-card--paste">Pasted shift list</span>
        </div>
        <div class="re-hero-flow-line" aria-hidden="true">
          <span>Import</span>
          <span>Shape</span>
          <span>Plan</span>
        </div>
        <figure class="re-device-shot re-device-shot--front">
          <Image src={shiftTodayShot} alt="RosterEase Shift Worker Today screen showing the next shift and upcoming roster." widths={[520, 760, 980]} sizes="(max-width: 960px) 72vw, 24rem" format="avif" quality={92} loading="eager" fetchpriority="high" />
        </figure>
        <figure class="re-device-shot re-device-shot--back">
          <Image src={fieldTodayShot} alt="RosterEase Field Worker Today screen showing visit progress, route timing, and client stops." widths={[420, 620, 820]} sizes="(max-width: 960px) 48vw, 18rem" format="avif" quality={90} loading="eager" />
        </figure>
        <div class="re-hero-output-card" aria-hidden="true">
          <span>Today plan ready</span>
          <p>Calendar + widgets optional</p>
        </div>
      </div>
    </div>
  </section>

  <section class="re-capability-strip" aria-label="Core capabilities">
    <div class="re-shell re-capability-strip__grid">
      {capabilities.map(([title, text]) => (
        <article>
          <h2>{title}</h2>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="re-journey-section" aria-labelledby="journey-title" data-motion-sequence>
    <div class="re-shell re-journey-grid">
      <div class="re-journey-copy">
        <p class="re-kicker">Workday journey</p>
        <h2 class="re-section-title" id="journey-title">Your roster, shaped into the day.</h2>
        <p class="re-body-copy">
          RosterEase follows the path most workdays already take: capture the details you were given,
          turn them into a readable plan, then decide which extras belong in Calendar, widgets, maps, or feedback.
        </p>
        <div class="re-journey-steps" aria-label="RosterEase workday journey">
          <span>Import</span>
          <span>Plan</span>
          <span>Route</span>
          <span>Protect</span>
        </div>
      </div>

      <div class="re-journey-stage" aria-hidden="true">
        <div class="re-journey-source-stack">
          <span class="re-source-card re-source-card--screenshot"><i>Screenshot</i><b></b><b></b><b></b></span>
          <span class="re-source-card re-source-card--pdf"><i>PDF</i><b></b><b></b></span>
          <span class="re-source-card re-source-card--paste"><i>Pasted roster</i><b></b><b></b><b></b></span>
          <span class="re-source-card re-source-card--clients"><i>Client list</i><b></b><b></b></span>
        </div>

        <div class="re-journey-spine">
          <span class="re-spine-step re-spine-step--import">Import</span>
          <span class="re-spine-step re-spine-step--shape">Shape</span>
          <span class="re-spine-step re-spine-step--protect">Protect</span>
        </div>

        <div class="re-journey-outcome-card">
          <figure class="re-journey-phone re-journey-phone--primary">
            <Image src={shiftTodayShot} alt="" widths={[420, 620, 820]} sizes="(max-width: 720px) 62vw, 16rem" format="avif" quality={90} loading="lazy" />
          </figure>
          <div class="re-journey-output-chips">
            <span>Today</span>
            <span>Calendar</span>
            <span>Widget</span>
            <span class="re-output-chip--lock">Privacy lock</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="re-motion-section" aria-label="How RosterEase works" data-motion-sequence>
    <div class="re-shell re-motion-grid">
      <div class="re-motion-copy">
        <h2 class="re-section-title">From roster chaos to a plan you can trust.</h2>
        <p class="re-body-copy">
          RosterEase is for the moment when the work details already exist somewhere else — and you need them clear enough to carry through the day.
        </p>
      </div>
      <div class="re-motion-rail">
        {motionItems.map((item) => (
          <article class="re-motion-card">
            <div class={`re-motion-visual re-motion-visual--${item.animation}`} aria-hidden="true">
              <span class="re-motion-visual__glow"></span>
              {item.animation === "import" && (
                <svg class="re-motion-icon" viewBox="0 0 64 64"><rect x="18" y="12" width="28" height="40" rx="7"/><path d="M24 25h16M24 33h12M32 43l7-7M32 43l-7-7"/><path class="re-motion-icon__accent" d="M22 17h20"/></svg>
              )}
              {item.animation === "route" && (
                <svg class="re-motion-icon" viewBox="0 0 64 64"><path d="M16 46c8-20 26 4 34-22"/><circle cx="16" cy="46" r="5"/><circle cx="50" cy="24" r="5"/><path class="re-motion-icon__accent" d="M30 24h8M34 20v8"/></svg>
              )}
              {item.animation === "privacy" && (
                <svg class="re-motion-icon" viewBox="0 0 64 64"><path d="M32 8l18 8v15c0 12-7 20-18 25-11-5-18-13-18-25V16l18-8z"/><path class="re-motion-icon__accent" d="M25 32l5 5 10-12"/></svg>
              )}
            </div>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="re-product-section" id="product">
    <div class="re-shell re-product-grid">
      <div class="re-product-copy">
        <p class="re-kicker">Current app</p>
        <h2 class="re-section-title">Designed for the day you actually work.</h2>
        <p class="re-body-copy">
          RosterEase starts with your work pattern, then keeps the details close: shifts and workplaces for rostered days, clients and route progress for field days, and privacy controls for both.
        </p>
      </div>
      <div class="re-feature-matrix">
        <article>
          <span>01</span>
          <h3>Import first</h3>
          <p>Use camera, image, PDF, file, or paste flows when your roster or client list already exists somewhere else.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Plan on iPhone and iPad</h3>
          <p>Today, Calendar, Workplaces or Clients, Settings, widgets, backup, restore, and reset are designed as working app surfaces, not just setup screens.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Keep sharing explicit</h3>
          <p>Notes, Calendar details, Maps estimates, backup, restore, reset, and privacy lock are surfaced as choices rather than assumptions.</p>
        </article>
        <div class="re-product-mode-details" aria-label="RosterEase mode details">
          {modes.map((mode) => (
            <article class={`re-product-mode-detail re-product-mode-detail--${mode.icon}`}>
              <span>{mode.label}</span>
              <h3>{mode.title}</h3>
              <ul>
                {mode.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="re-showcase" id="screens" data-route-showcase>
    <div class="re-shell">
      <div class="re-showcase__header">
        <div>
          <p class="re-kicker">Screens</p>
          <h2 class="re-section-title">Choose your way of working.</h2>
        </div>
        <p class="re-body-copy">
          Switch between the two RosterEase flows and follow how the app turns a schedule source into a practical day plan.
        </p>
      </div>

      <div class="re-showcase__switch" role="tablist" aria-label="Choose a RosterEase worker mode">
        {showcaseFlows.map((flow, flowIndex) => (
          <button
            class="re-showcase__mode"
            type="button"
            role="tab"
            id={`showcase-tab-${flow.id}`}
            aria-controls={`showcase-panel-${flow.id}`}
            aria-selected={flowIndex === 0 ? "true" : "false"}
            tabindex={flowIndex === 0 ? "0" : "-1"}
            data-showcase-mode={flow.id}
          >
            <span class="re-showcase__mode-kicker">{flow.accent === "shift" ? "Mode 01" : "Mode 02"}</span>
            <span class="re-showcase__mode-title">{flow.label}</span>
            <span class="re-showcase__mode-hint">{flow.modeHint}</span>
          </button>
        ))}
      </div>

      <div class="re-showcase__panels">
        {showcaseFlows.map((flow, flowIndex) => (
          <article
            class={`re-showcase__panel re-showcase__panel--${flow.accent}`}
            id={`showcase-panel-${flow.id}`}
            role="tabpanel"
            aria-labelledby={`showcase-tab-${flow.id}`}
            data-showcase-panel={flow.id}
            data-active-index="0"
            hidden={flowIndex === 0 ? undefined : true}
          >
            <div class="re-showcase__intro">
              <h3>{flow.title}</h3>
              <p>{flow.text}</p>
            </div>

            <div class="re-route-line" aria-label={`${flow.label} guided demo steps`}>
              {flow.steps.map((step, stepIndex) => (
                <button
                  class="re-route-line__stop"
                  type="button"
                  data-showcase-step={stepIndex}
                  aria-controls={`showcase-copy-${flow.id}`}
                  aria-pressed={stepIndex === 0 ? "true" : "false"}
                  aria-current={stepIndex === 0 ? "step" : undefined}
                >
                  <span class="re-route-line__dot" aria-hidden="true"></span>
                  <span class="re-route-line__text">
                    <span class="re-route-line__count">Step {stepIndex + 1}</span>
                    <span class="re-route-line__label">{step.label}</span>
                  </span>
                </button>
              ))}
            </div>

            <div class="re-showcase__stage">
              <button class="re-showcase__arrow" type="button" data-showcase-prev aria-label={`Show previous ${flow.label} screen`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
              </button>

              <div class="re-showcase__copy" id={`showcase-copy-${flow.id}`} data-showcase-copy aria-live="polite" aria-atomic="true">
                <span>{flow.steps[0].label}</span>
                <h4>{flow.steps[0].title}</h4>
                <p>{flow.steps[0].text}</p>
              </div>

              <div class="re-showcase__screens" data-showcase-screens aria-roledescription="carousel" aria-label={`${flow.label} screenshots`}>
                {flow.steps.map((step, stepIndex) => (
                  <figure
                    class="re-showcase__screen"
                    id={`showcase-screen-${flow.id}-${stepIndex}`}
                    data-showcase-screen={stepIndex}
                    aria-hidden={stepIndex === 0 ? "false" : "true"}
                    aria-label={`${step.label}: ${step.title}`}
                    aria-roledescription="slide"
                  >
                    <Image src={step.image} alt={step.alt} widths={[360, 520, 720, 960]} sizes="(max-width: 720px) 70vw, 22rem" format="avif" quality={90} loading="lazy" />
                  </figure>
                ))}
              </div>

              <button class="re-showcase__arrow" type="button" data-showcase-next aria-label={`Show next ${flow.label} screen`}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
              </button>
            </div>

            <div class="re-showcase__dots" aria-label={`${flow.label} quick screenshot controls`}>
              {flow.steps.map((step, stepIndex) => (
                <button
                  type="button"
                  data-showcase-dot={stepIndex}
                  aria-label={`Show ${step.label} screen`}
                  aria-controls={`showcase-screen-${flow.id}-${stepIndex}`}
                  aria-pressed={stepIndex === 0 ? "true" : "false"}
                  aria-current={stepIndex === 0 ? "true" : undefined}
                ></button>
              ))}
            </div>

            <script type="application/json" data-showcase-data={flow.id} set:html={JSON.stringify(flow.steps.map(({ label, title, text }) => ({ label, title, text })))} />
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="re-privacy-band" aria-labelledby="privacy-band-title">
    <div class="re-shell re-privacy-band__grid">
      <div class="re-privacy-band__copy">
        <p class="re-kicker">Privacy by default</p>
        <h2 class="re-section-title" id="privacy-band-title">Useful planning, without making sensitive sharing automatic.</h2>
        <p class="re-body-copy">
          RosterEase is being shaped around local-first defaults and clear opt-ins, especially for notes,
          Calendar details, route estimates, and tester feedback.
        </p>
      </div>
      <div class="re-privacy-band__list">
        {privacyPoints.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="re-beta" id="beta">
    <div class="re-shell">
      <div class="re-beta__card re-beta__card--launch">
        <div class="re-beta__copy">
          <span class="re-beta__chip">TestFlight invitation</span>
          <h2 class="re-beta__title">Try RosterEase before 1.0 and help shape what ships.</h2>
          <p class="re-beta__body">Use the current build with a real setup path and tell us where importing, privacy wording, or day planning still needs to feel calmer.</p>
          <ul class="re-beta__list">
            <li>Fresh-install onboarding, mode choice, and first-run setup.</li>
            <li>Roster imports, Calendar sync, Field Worker routes, privacy lock, widgets, and iPad layout.</li>
            <li>Accessibility settings, backup, restore, reset, and safely redacted failed-import examples.</li>
          </ul>
        </div>
        <div class="re-beta__cta">
          <a class="re-button re-button--primary" href={TESTFLIGHT_URL} target="_blank" rel="noopener" data-testflight-url>
            Join TestFlight
          </a>
          <div class="re-beta__fineprint">
            <p>Requires Apple TestFlight.</p>
            <p>Feedback and redacted import examples can go to <a href={TESTFLIGHT_MAILTO}>{TESTFLIGHT_EMAIL}</a>.</p>
            <p>Remove names, addresses, phone numbers, employee IDs, client identifiers, and private support or medical notes first. <a href="/privacy">Read privacy details</a>.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="re-frontpage-panel">
    <div class="re-shell re-frontpage-panel__grid">
      <div class="re-frontpage-panel__copy">
        <p class="re-kicker">Support</p>
        <h2 class="re-section-title">Bring us the roster mess worth solving.</h2>
        <p class="re-body-copy">
          A confusing roster import, a route day that feels wrong, or a privacy setting that needs clearer wording is exactly the feedback needed before 1.0. If you can share a roster that fails import, redact names, addresses, phone numbers, employee IDs, client identifiers, and private notes before sending it to the dedicated TestFlight email.
        </p>
        <div class="re-button-row">
          <a class="re-button re-button--primary" href="/contact">Contact support</a>
          <a class="re-button re-button--secondary" href={TESTFLIGHT_MAILTO}>Email {TESTFLIGHT_EMAIL}</a>
        </div>
      </div>
      <aside class="re-support-panel re-support-panel--frontpage">
        <p class="re-support-panel__label">Tester focus</p>
        <h3 class="re-support-panel__title">Shift mode, field mode, import, privacy, widgets, and iPad.</h3>
        <p class="re-body-copy">Those are the launch-readiness paths being tightened before the full App Store release.</p>
      </aside>
    </div>
  </section>
</RosterEaseLayout>


<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const motionSections = Array.from(document.querySelectorAll("[data-motion-sequence]"));
  if (motionSections.length && !prefersReducedMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add("is-in-view");
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.28 },
    );
    for (const section of motionSections) observer.observe(section);
  } else {
    for (const section of motionSections) section.classList.add("is-in-view");
  }

  for (const root of document.querySelectorAll("[data-route-showcase]")) {
    const tabs = Array.from(root.querySelectorAll("[data-showcase-mode]"));
    const panels = Array.from(root.querySelectorAll("[data-showcase-panel]"));

    function updatePanel(panel, nextIndex) {
      const dataNode = panel.querySelector("[data-showcase-data]");
      if (!dataNode?.textContent) return;
      const steps = JSON.parse(dataNode.textContent);
      const index = (nextIndex + steps.length) % steps.length;
      const copy = panel.querySelector("[data-showcase-copy]");
      const screens = Array.from(panel.querySelectorAll("[data-showcase-screen]"));
      const stops = Array.from(panel.querySelectorAll("[data-showcase-step]"));
      const dots = Array.from(panel.querySelectorAll("[data-showcase-dot]"));
      const activeStep = steps[index];

      panel.dataset.activeIndex = String(index);
      if (copy && activeStep) {
        copy.querySelector("span").textContent = activeStep.label;
        copy.querySelector("h4").textContent = activeStep.title;
        copy.querySelector("p").textContent = activeStep.text;
      }

      for (const [screenIndex, screen] of screens.entries()) {
        screen.classList.toggle("is-active", screenIndex === index);
        screen.setAttribute("aria-hidden", screenIndex === index ? "false" : "true");
      }

      for (const [stopIndex, stop] of stops.entries()) {
        if (stopIndex === index) {
          stop.setAttribute("aria-current", "step");
          stop.setAttribute("aria-pressed", "true");
        } else {
          stop.removeAttribute("aria-current");
          stop.setAttribute("aria-pressed", "false");
        }
      }

      for (const [dotIndex, dot] of dots.entries()) {
        if (dotIndex === index) {
          dot.setAttribute("aria-current", "true");
          dot.setAttribute("aria-pressed", "true");
        } else {
          dot.removeAttribute("aria-current");
          dot.setAttribute("aria-pressed", "false");
        }
      }
    }

    function activateMode(mode, focusTab = false) {
      for (const tab of tabs) {
        const isActive = tab.getAttribute("data-showcase-mode") === mode;
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
        tab.setAttribute("tabindex", isActive ? "0" : "-1");
        if (isActive && focusTab) tab.focus();
      }
      for (const panel of panels) {
        const isActive = panel.getAttribute("data-showcase-panel") === mode;
        panel.hidden = !isActive;
        if (isActive) updatePanel(panel, Number(panel.dataset.activeIndex || 0));
      }
    }

    function activateTabAt(index, focusTab = true) {
      const nextTab = tabs[(index + tabs.length) % tabs.length];
      const mode = nextTab?.getAttribute("data-showcase-mode");
      if (mode) activateMode(mode, focusTab);
    }

    for (const [tabIndex, tab] of tabs.entries()) {
      tab.addEventListener("click", () => activateMode(tab.getAttribute("data-showcase-mode")));
      tab.addEventListener("keydown", (event) => {
        if (!["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) return;
        event.preventDefault();
        if (event.key === "Home") return activateTabAt(0);
        if (event.key === "End") return activateTabAt(tabs.length - 1);
        activateTabAt(tabIndex + (event.key === "ArrowRight" ? 1 : -1));
      });
    }

    for (const panel of panels) {
      updatePanel(panel, 0);
      panel.querySelector("[data-showcase-prev]")?.addEventListener("click", () => updatePanel(panel, Number(panel.dataset.activeIndex || 0) - 1));
      panel.querySelector("[data-showcase-next]")?.addEventListener("click", () => updatePanel(panel, Number(panel.dataset.activeIndex || 0) + 1));
      for (const stop of panel.querySelectorAll("[data-showcase-step]")) {
        stop.addEventListener("click", () => updatePanel(panel, Number(stop.getAttribute("data-showcase-step") || 0)));
      }
      for (const dot of panel.querySelectorAll("[data-showcase-dot]")) {
        dot.addEventListener("click", () => updatePanel(panel, Number(dot.getAttribute("data-showcase-dot") || 0)));
      }
      panel.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        updatePanel(panel, Number(panel.dataset.activeIndex || 0) + (event.key === "ArrowRight" ? 1 : -1));
      });
    }
  }
</script>
