---
import RosterEaseLayout from "../layouts/RosterEaseLayout.astro";
---

<RosterEaseLayout
  title="Page not found"
  description="Find your way back to RosterEase, its help guides or support."
  noindex
>
  <div class="re-shell">
    <section class="re-page-intro">
      <p class="re-kicker">404 · Page not found</p>
      <h1>That page isn’t here.</h1>
      <p>
        The link may be out of date, or the address may contain a typo.
        You can return home or find help below.
      </p>
      <nav class="re-subnav" aria-label="Find your way back">
        <a href="/">Return home →</a>
        <a href="/help/">Help guides →</a>
        <a href="/contact/">Contact support →</a>
      </nav>
    </section>
  </div>
</RosterEaseLayout>
