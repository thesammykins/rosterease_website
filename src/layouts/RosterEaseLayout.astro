---
import "../styles/rosterease.css";
import ScreenshotViewer from "../components/ScreenshotViewer.astro";
import appIcon from "../assets/rosterease/rosterease-app-icon.svg";
import ogImage from "../assets/rosterease/og-image.png";
import { TESTFLIGHT_URL } from "../lib/rosterease";
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = "A personal planner for repeating shifts and client visits. Made for iPhone and iPad.",
} = Astro.props;
const fullTitle = title === "RosterEase" ? title : `${title} | RosterEase`;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical = new URL(path, Astro.site ?? "https://rosterease.app").href;
const imageUrl = new URL(ogImage.src, Astro.site ?? "https://rosterease.app")
  .href;
const navigation = [
  { href: "/app", label: "The app" },
  { href: "/contact", label: "Support" },
  { href: "/privacy", label: "Privacy" },
];
const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "RosterEase",
  url: "https://rosterease.app/",
  description,
  applicationCategory: "ProductivityApplication",
  operatingSystem: "iOS, iPadOS",
});
---

<!doctype html>
<html lang="en-AU" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <script is:inline>
      try {
        const theme = localStorage.getItem("rosterease-theme");
        if (["light", "dark", "system"].includes(theme))
          document.documentElement.dataset.theme = theme;
      } catch (error) {
        console.info("Theme preference unavailable; using system appearance.");
      }
    </script>
    <link rel="icon" type="image/svg+xml" href={appIcon.src} />
    <link rel="canonical" href={canonical} />
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RosterEase" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={ogImage.width} />
    <meta property="og:image:height" content={ogImage.height} />
    <meta property="og:image:alt" content="RosterEase workday planner" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      path === "/" && (
        <script type="application/ld+json" set:html={structuredData} />
      )
    }
  </head>
  <body>
    <a class="re-skip-link" href="#content">Skip to content</a>
    <header class="re-site-header">
      <div class="re-shell re-header-inner">
        <a class="re-brand" href="/" aria-label="RosterEase home"
          ><img src={appIcon.src} alt="" width="36" height="36" /><span
            >RosterEase</span
          ></a
        >
        <nav class="re-nav" aria-label="Main navigation">
          {
            navigation.map((item) => (
              <a
                href={item.href}
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          class="re-button re-header-cta"
          href={TESTFLIGHT_URL}
          target="_blank"
          rel="noopener">Join TestFlight <span aria-hidden="true">↗</span></a
        >
        <details class="re-mobile-menu">
          <summary>Menu</summary>
          <nav aria-label="Mobile navigation">
            {
              navigation.map((item) => (
                <a
                  href={item.href}
                  aria-current={path === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a href="/help">Help guides</a>
          </nav>
        </details>
      </div>
    </header>
    <main id="content" tabindex="-1"><slot /></main>
    <ScreenshotViewer />
    <footer class="re-site-footer">
      <div class="re-shell">
        <div class="re-footer-top">
          <div>
            <a class="re-brand" href="/" aria-label="RosterEase home"
              ><img src={appIcon.src} alt="" width="36" height="36" /><span
                >RosterEase</span
              ></a
            ><p>A personal workday planner.<br />Made for iPhone and iPad.</p>
          </div>
          <nav class="re-footer-links" aria-label="Footer navigation">
            <a href="/app">The app</a><a href="/help">Help guides</a><a
              href="/contact">Support</a
            ><a href="/privacy">Privacy Policy</a><a href="/terms"
              >Terms of Use</a
            ><a href="/credits">Credits</a>
          </nav>
          <div class="re-footer-cta">
            <a
              class="re-button"
              href={TESTFLIGHT_URL}
              target="_blank"
              rel="noopener"
              >Join TestFlight <span aria-hidden="true">↗</span></a
            ><p>App Store release coming soon</p>
          </div>
        </div>
        <div class="re-footer-bottom">
          <p>
            © {new Date().getFullYear()} RosterEase · <a
              href="https://samanthamyers.au">Samantha Myers</a
            >
          </p>
          <details class="re-appearance">
            <summary aria-label="Choose appearance" title="Choose appearance">
              <svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
                ><circle cx="12" cy="12" r="8"></circle><path
                  d="M12 4a8 8 0 0 1 0 16Z"
                  fill="currentColor"
                  stroke="none"></path></svg
              >
            </summary>
            <fieldset class="re-theme-switch">
              <legend>Appearance</legend>{
                ["light", "dark", "system"].map((theme) => (
                  <label>
                    <>
                      <input
                        type="radio"
                        name="theme"
                        value={theme}
                        checked={theme === "system"}
                      />
                      <span>{theme[0].toUpperCase() + theme.slice(1)}</span>
                    </>
                  </label>
                ))
              }
            </fieldset>
          </details>
        </div>
      </div>
    </footer>
    <script>
      import { initSiteMotion } from "../scripts/site-motion";
      const choices = document.querySelectorAll<HTMLInputElement>(
        'input[name="theme"]',
      );
      const appearance =
        document.querySelector<HTMLDetailsElement>(".re-appearance");
      const appearanceTrigger = appearance?.querySelector("summary");
      const selected = document.documentElement.dataset.theme ?? "system";
      const describeAppearance = (theme: string) => {
        const label = `Appearance: ${theme}. Choose appearance`;
        appearanceTrigger?.setAttribute("aria-label", label);
        appearanceTrigger?.setAttribute("title", label);
      };
      const updateScreens = (theme: string) => {
        document
          .querySelectorAll<HTMLSourceElement>("[data-dark-source]")
          .forEach((source) => {
            source.media =
              theme === "system"
                ? "(prefers-color-scheme: dark)"
                : theme === "dark"
                  ? "all"
                  : "not all";
          });
      };
      updateScreens(selected);
      describeAppearance(selected);
      choices.forEach((input) => {
        input.checked = input.value === selected;
        input.addEventListener("change", () => {
          document.documentElement.dataset.theme = input.value;
          describeAppearance(input.value);
          updateScreens(input.value);
          try {
            localStorage.setItem("rosterease-theme", input.value);
          } catch {
            console.info(
              "Theme preference could not be saved; appearance applies to this page.",
            );
          }
        });
      });
      initSiteMotion();
      const menu =
        document.querySelector<HTMLDetailsElement>(".re-mobile-menu");
      document.addEventListener("click", (event) => {
        if (
          appearance?.open &&
          event.target instanceof Node &&
          !appearance.contains(event.target)
        ) {
          appearance.open = false;
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && appearance?.open) {
          appearance.open = false;
          appearanceTrigger?.focus();
        }
        if (event.key === "Escape" && menu?.open) {
          menu.open = false;
          menu.querySelector("summary")?.focus();
        }
      });
    </script>
  </body>
</html>
