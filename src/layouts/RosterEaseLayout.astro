---
import "../styles/rosterease.css";
import appIcon from "../assets/rosterease/rosterease-app-icon.svg";
// 1200x630 landscape OG composite (scaled from app-store-today.png + brand-tinted padding via sips).
import ogImageAsset from "../assets/rosterease/og-image.png";
import { TESTFLIGHT_URL } from "../lib/rosterease";

export interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "RosterEase is an iPhone and iPad app for shift workers and field workers who want roster, route, import, privacy, widget, and calendar tools in one planner.",
} = Astro.props;

const fullTitle = title === "RosterEase" ? title : `${title} | RosterEase`;
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// Normalize canonical against the (trailing-slash-stripped) current path so canonical
// stays stable regardless of how the URL was requested (with/without trailing slash, query, hash).
const canonicalUrl = new URL(currentPath, Astro.url).href;
const ogImageUrl = new URL(ogImageAsset.src, Astro.url).href;
const ogImageAlt = "RosterEase - two-mode roster and route planner";
const isOverview = currentPath === "/";
const isPrivacy = currentPath === "/privacy";
const isContact = currentPath === "/contact";
---

<!doctype html>
<html lang="en" data-theme="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#101612" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      (() => {
        try {
          const theme = localStorage.getItem("rosterease-theme");
          if (theme === "light" || theme === "dark" || theme === "system") {
            document.documentElement.dataset.theme = theme;
          }
        } catch {
          document.documentElement.dataset.theme = "system";
        }
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href={appIcon.src} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{fullTitle}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="RosterEase" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(ogImageAsset.width)} />
    <meta property="og:image:height" content={String(ogImageAsset.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
  </head>
  <body class="re-body">
    <a class="re-skip-link" href="#content">Skip to content</a>

    <header class="re-site-header">
      <div class="re-shell re-site-header__inner">
        <a href="/" class="re-brand" aria-label="Go to the RosterEase overview page">
          <span class="re-brand__icon">
            <img src={appIcon.src} alt="" width="36" height="36" aria-hidden="true" />
          </span>
          <span class="re-brand__wordmark">RosterEase</span>
        </a>

        <nav class="re-nav" aria-label="RosterEase navigation">
          <a href="/" aria-current={isOverview ? "page" : undefined}>Overview</a>
          <a href="/#screens">Screens</a>
          <a href="/privacy" aria-current={isPrivacy ? "page" : undefined}>Privacy</a>
          <a href="/contact" aria-current={isContact ? "page" : undefined}>Contact</a>
        </nav>

        <details class="re-theme-menu" data-theme-menu>
          <summary class="re-theme-menu__button" aria-label="Choose colour theme">
            <svg class="re-theme-menu__icon" viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
              <path fill="currentColor" d="M12 18.25A6.25 6.25 0 1 1 12 5.75a6.25 6.25 0 0 1 0 12.5Zm0-2A4.25 4.25 0 1 0 12 7.75a4.25 4.25 0 0 0 0 8.5ZM12 3.5a1 1 0 0 1-1-1V1.25a1 1 0 1 1 2 0V2.5a1 1 0 0 1-1 1Zm0 20.25a1 1 0 0 1-1-1V21.5a1 1 0 1 1 2 0v1.25a1 1 0 0 1-1 1ZM3.5 13H2.25a1 1 0 1 1 0-2H3.5a1 1 0 1 1 0 2Zm18.25 0H20.5a1 1 0 1 1 0-2h1.25a1 1 0 1 1 0 2ZM5.64 6.64a1 1 0 0 1-.7-.29l-.9-.89a1 1 0 0 1 1.42-1.42l.89.9a1 1 0 0 1-.71 1.7Zm13.61 13.61a1 1 0 0 1-.71-.29l-.89-.9a1 1 0 0 1 1.41-1.41l.9.89a1 1 0 0 1-.71 1.71ZM4.75 20.25a1 1 0 0 1-.71-1.71l.9-.89a1 1 0 0 1 1.41 1.41l-.89.9a1 1 0 0 1-.71.29ZM18.36 6.64a1 1 0 0 1-.71-1.7l.89-.9a1 1 0 1 1 1.42 1.42l-.9.89a1 1 0 0 1-.7.29Z" />
            </svg>
          </summary>

          <fieldset class="re-theme-switch" aria-label="Colour theme">
            <legend>Theme</legend>
            <label for="re-theme-light">
              <input id="re-theme-light" type="radio" name="re-theme" value="light" aria-label="Use light theme" />
              <span>Light</span>
            </label>
            <label for="re-theme-dark">
              <input id="re-theme-dark" type="radio" name="re-theme" value="dark" aria-label="Use dark theme" />
              <span>Dark</span>
            </label>
            <label for="re-theme-system">
              <input id="re-theme-system" type="radio" name="re-theme" value="system" checked aria-label="Use system theme" />
              <span>System</span>
            </label>
          </fieldset>
        </details>
      </div>
    </header>

    <main id="content" class="re-site-main" tabindex="-1">
      <slot />
    </main>

    <footer class="re-site-footer">
      <div class="re-shell re-footer">
        <div class="re-footer__brand">
          <a href="/" class="re-brand re-brand--footer" aria-label="Go to the RosterEase overview page">
            <span class="re-brand__icon">
              <img src={appIcon.src} alt="" width="36" height="36" aria-hidden="true" />
            </span>
            <span class="re-brand__wordmark">RosterEase</span>
          </a>

          <p>
            An iPhone and iPad app for shift workers and field workers preparing for a 1.0 launch through TestFlight.
          </p>
        </div>

        <div class="re-footer__meta">
          <div class="re-footer__links">
            <a href="/">Overview</a>
            <a href="/#screens">Screens</a>
            <a href="/privacy">Privacy</a>
            <a href="/contact">Contact</a>
          </div>

          <div class="re-footer__actions">
            <a class="re-button re-button--primary" href={TESTFLIGHT_URL} target="_blank" rel="noopener">Join TestFlight</a>
            <a class="re-badge re-badge--appstore" href="#" data-coming-soon aria-label="RosterEase is coming to the App Store">
              <svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22"><path fill="currentColor" d="M17.05 12.04c-.03-2.07 1.69-3.06 1.77-3.12-.97-1.41-2.48-1.6-3.01-1.62-1.28-.13-2.5.76-3.15.76-.65 0-1.65-.74-2.71-.72-1.4.02-2.69.81-3.41 2.06-1.46 2.53-.37 6.27 1.04 8.32.69 1.01 1.51 2.13 2.58 2.09 1.04-.04 1.43-.67 2.69-.67 1.25 0 1.61.67 2.71.65 1.12-.02 1.83-1.02 2.51-2.03.79-1.17 1.12-2.31 1.13-2.37-.02-.01-2.17-.83-2.19-3.3zM15.2 6.04c.57-.69.96-1.66.85-2.62-.83.03-1.83.55-2.42 1.24-.53.61-.99 1.59-.87 2.53.92.07 1.87-.47 2.44-1.15z"/></svg>
              <span class="re-badge__label"><small>Coming to the</small>App Store</span>
            </a>
            <a href="https://samanthamyers.au">Main site</a>
            <a href="/contact">Support</a>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const THEME_STORAGE_KEY = "rosterease-theme";
      const themeChoices = new Set(["light", "dark", "system"]);
      const themeInputs = Array.from(document.querySelectorAll('input[name="re-theme"]'));
      const themeMenu = document.querySelector("[data-theme-menu]");

      function storedTheme() {
        const value = localStorage.getItem(THEME_STORAGE_KEY);
        return themeChoices.has(value) ? value : "system";
      }

      function applyTheme(theme) {
        const nextTheme = themeChoices.has(theme) ? theme : "system";
        document.documentElement.dataset.theme = nextTheme;
        for (const input of themeInputs) {
          input.checked = input.value === nextTheme;
        }
      }

      applyTheme(storedTheme());

      for (const input of themeInputs) {
        input.addEventListener("change", () => {
          if (!input.checked) return;
          localStorage.setItem(THEME_STORAGE_KEY, input.value);
          applyTheme(input.value);
          themeMenu?.removeAttribute("open");
        });
      }
    </script>
  </body>
</html>
