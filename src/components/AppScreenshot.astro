---
import { getImage } from "astro:assets";
import type { AppScreen } from "../lib/screenshots";
interface Props {
  screen: AppScreen;
  eager?: boolean;
  draggable?: boolean;
  sizes?: string;
  widths?: number[];
}
const {
  screen,
  eager = false,
  draggable = true,
  sizes = "280px",
  widths = [320, 480, 640],
} = Astro.props;
const light = await getImage({
  src: screen.light ?? screen.dark,
  width: 640,
  widths,
  format: "webp",
  quality: 85,
});
const dark = await getImage({
  src: screen.dark,
  width: 640,
  widths,
  format: "webp",
  quality: 85,
});
const fullLight = await getImage({
  src: screen.light ?? screen.dark,
  width: 1206,
  format: "webp",
  quality: 90,
});
const fullDark = await getImage({
  src: screen.dark,
  width: 1206,
  format: "webp",
  quality: 90,
});
---

<picture
  data-app-screen
  data-full-light={fullLight.src}
  data-full-dark={fullDark.src}
>
  <source
    media="(prefers-color-scheme: dark)"
    srcset={dark.srcSet.attribute}
    sizes={sizes}
    data-dark-source
  />
  <img
    draggable={draggable}
    src={light.src}
    srcset={light.srcSet.attribute}
    sizes={sizes}
    alt={screen.alt}
    width={light.attributes.width}
    height={light.attributes.height}
    loading={eager ? "eager" : "lazy"}
    decoding="async"
    fetchpriority={eager ? "high" : "auto"}
  />
</picture>
