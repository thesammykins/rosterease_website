---
import AppScreenshot from "./AppScreenshot.astro";
import DeviceFrame from "./DeviceFrame.astro";
import type { AppScreen } from "../lib/screenshots";
interface Step {
  title: string;
  text: string;
  href: string;
  link: string;
  screen: AppScreen;
}
interface Props {
  id: string;
  mode: "shift" | "field";
  title: string;
  who: string;
  steps: Step[];
}
const { id, mode, title, who, steps } = Astro.props;
---

<section
  class={`re-chapter re-chapter--${mode}`}
  id={id}
  aria-labelledby={`${id}-title`}
  data-chapter
>
  <div class="re-shell re-chapter-inner">
    <h2 class="re-chapter-title" id={`${id}-title`}>{title}</h2>
    <p class="re-chapter-who">{who}</p>
    <div class="re-chapter-body">
      <ol class="re-chapter-steps" aria-label={`${title}, step by step`}>
        {
          steps.map((step, index) => (
            <li class="re-chapter-step" data-chapter-step={index}>
              <div class="re-chapter-copy">
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                <a class="re-text-link" href={step.href} data-astro-prefetch>
                  {step.link} <span aria-hidden="true">→</span>
                </a>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="re-chapter-stage" aria-hidden="true" data-chapter-stage>
        <DeviceFrame device="iphone17" sizes="(max-width: 900px) 220px, 360px">
          {
            steps.map((step) => (
              <AppScreenshot
                screen={step.screen}
                sizes="(max-width: 900px) 220px, 360px"
                widths={[480, 720, 960]}
                draggable={false}
              />
            ))
          }
        </DeviceFrame>
      </div>
    </div>
  </div>
</section>

<script>
  // Desktop: the step nearest the middle of the screen is active, and the
  // stage device shows its screen. The header chips follow the chapter in view.
  const chapters = [...document.querySelectorAll<HTMLElement>("[data-chapter]")];
  const chips = [...document.querySelectorAll<HTMLAnchorElement>(".re-chapter-nav a")];
  function activate(chapter: HTMLElement, index: number) {
    chapter.querySelectorAll("[data-chapter-step]").forEach((step, i) => step.classList.toggle("is-active", i === index));
    chapter.querySelectorAll("[data-chapter-stage] picture").forEach((picture, i) => picture.classList.toggle("is-active", i === index));
  }
  // Desktop: the step whose text is nearest the middle of the screen is
  // active, so the lit text sits beside the screenshot the stage shows.
  // Phones: each step's text pins under the stage in turn and pushes the
  // last one up behind it; a step is active once it is the more visible one.
  const current = new Map<HTMLElement, number>();
  const phone = matchMedia("(max-width: 900px)");
  function follow() {
    for (const chapter of chapters) {
      const copies = [...chapter.querySelectorAll<HTMLElement>(".re-chapter-copy")];
      let nearest = 0;
      if (phone.matches) {
        const pin = parseFloat(getComputedStyle(copies[0]).top);
        copies.forEach((copy, i) => {
          if (copy.getBoundingClientRect().top <= pin + copy.offsetHeight / 2) nearest = i;
        });
      } else {
        let distance = Infinity;
        copies.forEach((copy, i) => {
          const box = copy.getBoundingClientRect();
          const d = Math.abs((box.top + box.bottom) / 2 - innerHeight / 2);
          if (d < distance) [nearest, distance] = [i, d];
        });
      }
      if (current.get(chapter) !== nearest) {
        current.set(chapter, nearest);
        activate(chapter, nearest);
      }
    }
  }
  let queued = false;
  const schedule = () => {
    if (queued) return;
    queued = true;
    requestAnimationFrame(() => {
      queued = false;
      follow();
    });
  };
  addEventListener("scroll", schedule, { passive: true });
  addEventListener("resize", schedule);
  follow();
  const inView = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        chips.forEach((chip) => chip.setAttribute("aria-current", String(chip.hash === `#${entry.target.id}`)));
      }
    },
    { rootMargin: "-40% 0px -55% 0px" },
  );
  chapters.forEach((chapter) => inView.observe(chapter));
  // A tapped chip is selected straight away, before the scroll lands.
  chips.forEach((chip) =>
    chip.addEventListener("click", () =>
      chips.forEach((other) => other.setAttribute("aria-current", String(other === chip))),
    ),
  );

</script>
